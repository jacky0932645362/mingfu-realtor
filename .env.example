# ─────────────────────────────────────────────
#  複製這個檔成 .env.local，把值填進去
#  🔴 .env.local 已經在 .gitignore 裡，不會進版控 —— 不要拿掉那行
# ─────────────────────────────────────────────

# ── 必填：資料庫（MySQL 8 或 TiDB Cloud，兩者都能跑）
# TiDB Cloud 有永久免費方案，個人用綽綽有餘
DATABASE_URL="mysql://user:password@host:4000/dbname?sslaccept=strict"

# ── 必填：網站網址（通知信裡的連結會用它）
# 本機開發填 http://localhost:3000，上線後換成你的正式網址
APPOINTMENT_BASE_URL="http://localhost:3000"

# ── 必填：管理密鑰（隨便生一組長亂數即可，用來簽「管理我的預約」連結）
# 產生指令：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APPOINTMENT_TOKEN_SECRET=""

# ── 必填：你的收信信箱（有新預約會寄到這）
APPOINTMENT_ADMIN_EMAIL="your-email@example.com"

# ─────────────────────────────────────────────
#  以下都是選配，不填也能跑，只是對應功能會關閉
# ─────────────────────────────────────────────

# ── 名片上要「公開顯示」的信箱
# 留空 = 名片上不出現 Email 那一列（預設就是留空，避免個人信箱被爬蟲收割）。
# 跟上面的 APPOINTMENT_ADMIN_EMAIL 是兩回事：那個是你自己收通知用的，不會公開。
NEXT_PUBLIC_OWNER_EMAIL=""

# ── 後台登入
# 兩種擇一，都不填的話 /admin/appointments 進不去（但前台預約功能正常）。
# AUTH_SECRET 兩種都要填，產生指令：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# 方式一：密碼登入（簡單，適合只有自己一個人管後台）
# 填了就啟用。登入時輸入這組密碼，身分會用下面 APPOINTMENT_ADMIN_EMAIL 那個信箱。
ADMIN_PASSWORD=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ── Google 日曆（預約成立自動建立日曆事件、發邀請給客戶）
# 不填就純存資料庫，後台照樣看得到預約
GOOGLE_CALENDAR_CLIENT_ID=""
GOOGLE_CALENDAR_CLIENT_SECRET=""
GOOGLE_CALENDAR_REFRESH_TOKEN=""
GOOGLE_CALENDAR_ID="primary"
# 要不要把客戶也加進日曆邀請（1 = 要）
APPOINTMENT_GOOGLE_INVITE_CUSTOMER="0"

# ── 寄信（Resend。不填就不寄任何信，預約還是成立）
RESEND_API_KEY=""
APPOINTMENT_NOTIFY_CUSTOMER="1"
APPOINTMENT_REMINDER_CUSTOMER="1"

# ── 機器人防護（Cloudflare Turnstile，免費）
# 不填就不驗證，建議上線後補上，否則會收到灌爆的假預約
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# ── 地址自動完成（Google Maps Places API，會產生費用）
# 不填就變成純文字輸入，功能正常
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

# ── LINE 通知（有新預約推到你的 LINE 群組）
LINE_CHANNEL_ACCESS_TOKEN=""
LINE_ADMIN_GROUP_ID=""

# ── 網站分析（都不填就完全不追蹤）
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
